# Server Port (default: 3000)
PORT=3000

# MongoDB Connection String (Atlas or Local)
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/craftify_db?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017/craftify_db

# JWT Secret Key (generate a secure random 64-character secret)
JWT=your_secure_jwt_secret_key_here
