# ==============================================================
# Craftify Labs - Environment Variables Reference
# ==============================================================
# Copy the relevant variables to Backend/.env and Frontend/.env

### Backend (Backend/.env)
PORT=3000
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/craftify_db?retryWrites=true&w=majority
JWT=replace_with_a_secure_random_64_character_hex_secret

### Frontend (Frontend/.env)
VITE_API_URL=http://localhost:3000/api
